SCK_HOST_ID=host-demo
SCK_CSD_ID=csd-demo
SCK_AUTH_KEY=replace-with-base64url-32-byte-value
SCK_ENC_KEY=replace-with-base64url-32-byte-value
SCK_SESSION_TTL_SECONDS=300
SCK_HANDSHAKE_TTL_SECONDS=30
SCK_MAX_REQUEST_BYTES=65536
SCK_CSD_MODE=external
SCK_CSD_BASE_URL=http://CSD_LAN_IP:8001

# Optional CSD listener settings (the CLI flags take precedence):
# SCK_CSD_BIND=0.0.0.0
# SCK_CSD_PORT=8001

# Optional external-device data/audit directories (absolute paths recommended):
# SCK_DATA_ROOT=/home/csd/SafeConnectKey/csd_data
# SCK_RESULTS_ROOT=/home/csd/SafeConnectKey/results
# SCK_VM_RESULTS=results/vm-run-001
